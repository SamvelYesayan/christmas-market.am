{
  "expo": {
    "name": "Christmas Market",
    "slug": "christmas-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "christmasmarket",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1430",
    "primaryColor": "#F2C46D",
    "description": "Christmas Market (christmas-market.am) — gifts, the 31-day Christmas Calendar, games, Frostspire Academy and the Magical Pioneer Card.",
    "ios": {
      "bundleIdentifier": "am.christmasmarket.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "am.christmasmarket.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1430",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1430"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F2C46D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
