# Christmas Market mobile app — public build-time settings. NO SECRETS here: every EXPO_PUBLIC_ value is
# compiled into the app bundle and readable by anyone who has the app.
#
# Copy to .env.local (git-ignored) and adjust.

# Backend origin (no trailing slash, no /api/v1). Leave EMPTY in development to use the computer that runs
# Expo (its LAN IP is detected automatically) on port 4000 — required for a physical phone, where "localhost"
# would mean the phone itself.
# Android emulator: http://10.0.2.2:4000   iOS simulator: http://localhost:4000   Phone: http://192.168.x.y:4000
EXPO_PUBLIC_API_URL=

# Port of the local API when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_API_PORT=4000

# The website, used for links that only exist on the web (e.g. Idram form payments, terms) — no trailing slash.
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=15000
