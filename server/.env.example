# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Local dev cluster (see README "Database"): trust auth on localhost:5433
DATABASE_URL=postgres://christmas@localhost:5433/christmas_market
DATABASE_SSL=false
# Comma-separated list of allowed browser origins
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
SESSION_TTL_DAYS=30
# Set to 1 when running behind one reverse proxy (nginx, Render, Fly…)
TRUST_PROXY=0
UPLOAD_DIR=uploads
LOG_LEVEL=info
STORE_TIMEZONE=Asia/Yerevan
# Development/QA only: pretend today is this date for the Advent calendar (ignored in production)
# ADVENT_DATE_OVERRIDE=2026-12-08

# ── Payments ──────────────────────────────────────────
# true → enables the clearly-labelled TEST payment method (orders flagged is_test). Never enable in production.
PAYMENTS_TEST_MODE=true
# Idram (https://idram.am) merchant credentials
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
# Ameriabank vPOS
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
AMERIA_API_URL=https://servicestest.ameriabank.am/VPOS
# ArCa (ipay.arca.am)
ARCA_MERCHANT_USER=
ARCA_MERCHANT_PASSWORD=
ARCA_API_URL=https://ipaytest.arca.am:8445/payment/rest
# Telcell Wallet
TELCELL_SHOP_ID=
TELCELL_SHOP_KEY=
# Stripe (international cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Magical Pioneer Card ──────────────────────────────
# disabled | http | sandbox   (sandbox = labelled dev-only adapter, refused in production)
PIONEER_MODE=disabled
PIONEER_API_BASE_URL=
PIONEER_API_KEY=
PIONEER_API_TIMEOUT_MS=8000
# Override if the real API uses different routes ({cardId} is substituted)
PIONEER_PATH_VERIFY=/cards/verify
PIONEER_PATH_BALANCE=/cards/{cardId}/balance
PIONEER_PATH_HISTORY=/cards/{cardId}/transactions
PIONEER_PATH_CREDIT=/cards/{cardId}/credit
PIONEER_PATH_REDEEM=/cards/{cardId}/redeem
PIONEER_DISCOUNT_PERCENT=5
