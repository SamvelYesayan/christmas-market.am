# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Local dev cluster (see README "Database"): trust auth on localhost:5433
DATABASE_URL=postgres://christmas@localhost:5433/christmas_market
DATABASE_SSL=false
# Comma-separated list of allowed browser origins
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
SESSION_TTL_DAYS=30
# Set to 1 when running behind one reverse proxy (nginx, Render, Fly…)
TRUST_PROXY=0
UPLOAD_DIR=uploads
LOG_LEVEL=info
STORE_TIMEZONE=Asia/Yerevan
# Development/QA only: pretend today is this date for the Advent calendar (ignored in production)
# ADVENT_DATE_OVERRIDE=2026-12-08

# ── Payments ──────────────────────────────────────────
# true → enables the clearly-labelled TEST payment method (orders flagged is_test). Never enable in production.
PAYMENTS_TEST_MODE=true
# Idram (https://idram.am) merchant credentials
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
# Ameriabank vPOS
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
AMERIA_API_URL=https://servicestest.ameriabank.am/VPOS
# ArCa (ipay.arca.am)
ARCA_MERCHANT_USER=
ARCA_MERCHANT_PASSWORD=
ARCA_API_URL=https://ipaytest.arca.am:8445/payment/rest
# Telcell Wallet
TELCELL_SHOP_ID=
TELCELL_SHOP_KEY=
# Stripe (international cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Magical Pioneer Card ──────────────────────────────
# disabled → card connection unavailable (nothing is simulated)
# magical  → the real Magical Pioneer Card system (magical-full). Uses its cardholder API:
#            POST /api/pioneer/login, GET /api/pioneer/me|transactions|rewards|announcements, POST /api/pioneer/logout
PIONEER_MODE=disabled
# Base URL of the Pioneer system (https:// required in production), e.g. https://magical.am
PIONEER_API_BASE_URL=
# Optional: where cardholders claim Pioneer rewards (default {PIONEER_API_BASE_URL}/pioneer-card)
PIONEER_PORTAL_URL=
PIONEER_API_TIMEOUT_MS=8000
# 64 hex chars; encrypts the per-account Pioneer session. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIONEER_SESSION_KEY=
PIONEER_DISCOUNT_PERCENT=5
