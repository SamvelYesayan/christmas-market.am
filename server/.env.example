# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Local dev cluster (see README "Database"): trust auth on localhost:5433
DATABASE_URL=postgres://christmas@localhost:5433/christmas_market
DATABASE_SSL=false
# Comma-separated list of allowed browser origins
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
SESSION_TTL_DAYS=30
# Set to 1 when running behind one reverse proxy (nginx, Render, Fly…)
TRUST_PROXY=0
UPLOAD_DIR=uploads
LOG_LEVEL=info
STORE_TIMEZONE=Asia/Yerevan
# Development/QA only: pretend today is this date for the Advent calendar (ignored in production)
# ADVENT_DATE_OVERRIDE=2026-12-08

# ── Payments ──────────────────────────────────────────
# true → enables the clearly-labelled TEST payment method (orders flagged is_test). Never enable in production.
PAYMENTS_TEST_MODE=true
# Idram (https://idram.am) merchant credentials
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
# Ameriabank vPOS
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
AMERIA_API_URL=https://servicestest.ameriabank.am/VPOS
# ArCa (ipay.arca.am)
ARCA_MERCHANT_USER=
ARCA_MERCHANT_PASSWORD=
ARCA_API_URL=https://ipaytest.arca.am:8445/payment/rest
# Telcell Wallet
TELCELL_SHOP_ID=
TELCELL_SHOP_KEY=
# Stripe (international cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Magical Pioneer Card (official Integration API v1) ──────────────
# Server-side only: the key must never reach the browser, Git, logs or docs.
#
# DEVELOPMENT (recommended): never put the production key on a development machine. Run the local mock
#   npm run magical:mock        (fake cards and points, 127.0.0.1 only)
# and use:
#   MAGICAL_PIONEER_API_URL=http://127.0.0.1:3900/api/integration/v1
#   MAGICAL_PIONEER_API_KEY=mgpc_test_mock_key_0123456789abcdefghijklmnopqrstu
# (a local Magical checkout at http://127.0.0.1:3000/api/integration/v1 with its own test key works too).
#
# SAFETY: outside NODE_ENV=production, point credits/debits are sent ONLY to a Magical on localhost. A development
# server pointed at magical.am never moves points, whatever key or scopes it has (it only links/reads cards).
MAGICAL_PIONEER_API_URL=https://magical.am/api/integration/v1
MAGICAL_PIONEER_API_KEY=
# The same two settings may instead be given as MAGICAL_API_BASE_URL / MAGICAL_API_KEY (used only when the names above are unset).
# Points: game rewards are credited and gifts redeemed only after a Magical administrator grants this key
# points:credit / points:debit (npm run integration -- grant-scope --name christmas-store --scope points:credit,points:debit).
MAGICAL_PIONEER_TIMEOUT_MS=10000
# Kill switch for points everywhere (production included): off = no credit/debit is ever sent.
MAGICAL_POINTS=auto
# auto (default): enabled when URL and key are set · disabled: switch the integration off
PIONEER_MODE=auto
PIONEER_DISCOUNT_PERCENT=5
